HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=admin
DATABASE_PASSWORD=change-me
DATABASE_NAME=project_db

# Managed media storage
MEDIA_STORAGE_PROVIDER=minio
MEDIA_UPLOAD_DIRECTORY=uploads/media
MEDIA_PUBLIC_PATH=/uploads/media
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/ctg-media
MEDIA_CACHE_CONTROL=public, max-age=31536000, immutable
MEDIA_UPLOAD_MAX_FILE_SIZE_BYTES=10485760
MEDIA_UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp

# MinIO connection used by NestJS. Use "minio" only when NestJS also runs
# inside this Compose network; use "localhost" for the current host-run setup.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=ctg-local-access
MINIO_SECRET_KEY=ctg-local-secret-change-me
MINIO_BUCKET=ctg-media
MINIO_REGION=us-east-1

# Local-provider alternative:
# MEDIA_STORAGE_PROVIDER=local
# MEDIA_PUBLIC_BASE_URL=http://localhost:3000
