# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
ENABLE_SWAGGER=true

# Exact browser origins. Do not include trailing slashes or paths.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Authentication
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRES_IN=1d

# Local PostgreSQL (Docker Compose publishes port 5433 by default)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=admin
DATABASE_PASSWORD=replace-with-a-local-password
DATABASE_NAME=project_db
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_EXPOSED_PORT=5433

# Railway production alternative:
# DATABASE_URL=postgresql://user:password@host:5432/database

# Managed media storage
MEDIA_STORAGE_PROVIDER=minio
MEDIA_UPLOAD_DIRECTORY=uploads/media
MEDIA_PUBLIC_PATH=/uploads/media
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/ctg-media
MEDIA_CACHE_CONTROL=public, max-age=31536000, immutable
MEDIA_UPLOAD_MAX_FILE_SIZE_BYTES=10485760
MEDIA_UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp

# Local MinIO connection
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-with-a-local-access-key
MINIO_SECRET_KEY=replace-with-a-local-secret-key
MINIO_BUCKET=ctg-media
MINIO_REGION=us-east-1

# Production S3-compatible storage (Cloudflare R2 example)
# MEDIA_STORAGE_PROVIDER=s3
# MEDIA_STORAGE_ENDPOINT=https://account-id.r2.cloudflarestorage.com
# MEDIA_STORAGE_REGION=auto
# MEDIA_STORAGE_BUCKET=ctg-media
# MEDIA_STORAGE_ACCESS_KEY_ID=replace-with-r2-access-key-id
# MEDIA_STORAGE_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# MEDIA_STORAGE_FORCE_PATH_STYLE=true
# MEDIA_PUBLIC_BASE_URL=https://media.example.com

# Explicit one-time admin seed only
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-one-time-password
ADMIN_STAFF_ID=ADMIN-001
